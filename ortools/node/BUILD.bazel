# The Node.js binding is primarily built via CMake; Bazel targets here exist
# for completeness but are tagged "manual" because they require an
# externally-provided node-addon-api / node-api-headers toolchain that is not
# part of the upstream Bazel module graph.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cpp_srcs",
    srcs = glob(["src/cpp/*.cc", "src/cpp/*.h"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ts_srcs",
    srcs = glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "proto_srcs",
    srcs = glob(["src/proto/*.ts"]),
    visibility = ["//visibility:public"],
)
